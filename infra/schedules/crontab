# Fluxion — tareas programadas de la aplicación web
# Sustituyen a los crons que declaraba vercel.json antes del cutover a Dokploy.
0 7 * * *  /opt/fluxion/app-cron.sh /api/cron/evidence-expiry
0 8 * * 1  /opt/fluxion/app-cron.sh /api/cron/review-reminders
# Minuto 17 y no en punto: reparte la carga frente a los dos de arriba.
17 * * * * /opt/fluxion/app-cron.sh /api/cron/incident-deadlines
# Minuto 40: reparte la carga frente a los otros tres.
40 * * * * /opt/fluxion/app-cron.sh /api/cron/cost-budgets
# Diario: la discordancia es una senal lenta; una pasada horaria repetiria
# el mismo aviso veinticuatro veces.
30 6 * * *  /opt/fluxion/app-cron.sh /api/cron/hitl-discordance
# Cada 5 minutos: la espera entre reintentos del outbox empieza en 1 minuto, asi
# que una cadencia mayor haria que el primer reintento tardase mas de lo que
# dice su propia politica.
*/5 * * * * /opt/fluxion/app-cron.sh /api/cron/outbox
