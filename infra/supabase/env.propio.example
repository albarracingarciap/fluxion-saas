# ─────────────────────────────────────────────────────────────────────────────
# Variables del stack propio de Supabase para Fluxion.
#
# Plantilla. Los valores reales van en el .env del servicio en Dokploy, NUNCA
# en el repositorio.
#
# Tres grupos:
#   NUEVO   se genera para esta instancia. No copiar del stack compartido.
#   COPIAR  se trae tal cual del .env actual.
#   FIJO    se deja como está salvo que haya un motivo.
# ─────────────────────────────────────────────────────────────────────────────


# ── NUEVO · Claves de la instancia ───────────────────────────────────────────
#
# JWT_SECRET firma los tokens. ANON_KEY y SERVICE_ROLE_KEY son JWT firmados con
# él, así que NO se pueden copiar del stack antiguo: no validarían.
#
#   JWT_SECRET=$(openssl rand -base64 48 | tr -d '/+=' | head -c 64)
#
# y las dos claves con el script del README.

JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Contraseña de PostgreSQL. Nueva, y distinta de la del stack compartido: es
# uno de los motivos de separarse.
#
#   openssl rand -base64 32 | tr -d '/+='

POSTGRES_PASSWORD=

# Cifrado interno de servicios. Aleatorias y sin reutilizar.
#
#   SECRET_KEY_BASE   openssl rand -base64 48 | tr -d '/+=' | head -c 64
#   VAULT_ENC_KEY     openssl rand -base64 24 | tr -d '/+=' | head -c 32
#   PG_META_CRYPTO_KEY openssl rand -base64 24 | tr -d '/+='
#
# ⚠️ VAULT_ENC_KEY es la clave con la que `supabase_vault` cifra los secretos de
# conectores y canales. Es exactamente el motivo por el que esos secretos NO
# viajan entre instancias: restaurados en otra, descifran basura. Se
# reintroducen a mano desde Ajustes.

SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=

# Acceso al panel de Studio (autenticación básica de Kong).

DASHBOARD_USERNAME=fluxion
DASHBOARD_PASSWORD=

# Protocolo S3 de Storage. Aleatorias; no se usan hoy porque los ficheros
# pesados están en MinIO, pero el servicio las exige.

S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=


# ── NUEVO · Direcciones ──────────────────────────────────────────────────────
#
# Durante la prueba, el dominio provisional. En el cambio final pasan a
# supabase.fluxion-ai.es, que es lo que evita tocar la aplicación dos veces.

SUPABASE_PUBLIC_URL=https://supabase2.fluxion-ai.es
API_EXTERNAL_URL=https://supabase2.fluxion-ai.es

# A dónde vuelve el usuario tras confirmar el correo o recuperar la contraseña.
SITE_URL=https://fluxion-ai.es
ADDITIONAL_REDIRECT_URLS=


# ── NUEVO · Esquemas expuestos ───────────────────────────────────────────────
#
# SIN `learning`: es de otro proyecto y esta instancia ya no lo aloja. Ahí está
# la poda.
#
# Si falta `telemetry`, PostgREST devuelve 404 a todo el módulo de
# observabilidad con toda la naturalidad del mundo.

PGRST_DB_SCHEMAS=public,storage,graphql_public,fluxion,compliance,rag,telemetry
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000


# ── COPIAR · Correo ──────────────────────────────────────────────────────────
#
# Del .env actual, tal cual. Si el correo no funciona, nadie puede confirmar su
# cuenta ni recuperar la contraseña, y eso no se descubre hasta el primer
# usuario nuevo.

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify


# ── COPIAR · Registro y proveedores externos ─────────────────────────────────
#
# Copiar del actual para que el onboarding se comporte igual. Ojo a
# DISABLE_SIGNUP: si está en true, no podrás registrarte al empezar limpio.

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_SECRET=

SAML_ENABLED=false
SAML_PRIVATE_KEY=
SAML_EXTERNAL_URL=
SAML_ALLOW_ENCRYPTED_ASSERTIONS=false
SAML_RATE_LIMIT_ASSERTION=15
SAML_RELAY_STATE_VALIDITY_PERIOD=300


# ── FIJO · Base de datos y agrupador de conexiones ───────────────────────────

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

POOLER_TENANT_ID=fluxion
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543


# ── FIJO · Resto ─────────────────────────────────────────────────────────────

JWT_EXPIRY=3600
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

STORAGE_TENANT_ID=fluxion
GLOBAL_S3_BUCKET=stub
REGION=eu-central-1

STUDIO_DEFAULT_ORGANIZATION=Fluxion
STUDIO_DEFAULT_PROJECT=Fluxion

MFA_TOTP_ENROLL_ENABLED=true
MFA_TOTP_VERIFY_ENABLED=true
MFA_PHONE_ENROLL_ENABLED=false
MFA_PHONE_VERIFY_ENABLED=false
MFA_MAX_ENROLLED_FACTORS=10

SMS_PROVIDER=twilio
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGE_SERVICE_SID=
SMS_MAX_FREQUENCY=5s
SMS_OTP_EXP=60
SMS_OTP_LENGTH=6
SMS_TEMPLATE=
SMS_TEST_OTP=

# Claves asimétricas: soporte reciente de Supabase que no usamos. Vacías.
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Studio lo usa para su asistente. Vacío si no se quiere.
OPENAI_API_KEY=
